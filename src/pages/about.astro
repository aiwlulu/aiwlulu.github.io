---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';
import { breadcrumbs, person } from '../schema';
const crumbs = [{ name: '首頁', href: '/' }, { name: '關於' }];
const profile = { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: person };
---

<Base title="關於過鹿人" description="過鹿人，喜歡閱讀和學習。這個部落格從 2020 年開始，記錄讀書心得、TED 演講筆記與好用工具，早期文章保留當時的觀點與紀錄。" jsonLd={[profile, breadcrumbs(crumbs)]}>
  <div class="head wrap narrow">
    <Crumbs items={crumbs} />
    <h1>About Me</h1>
  </div>
  <div class="wrap">
    <div class="prose">
      <h2 style="margin-top:0">{SITE.author}</h2>
      <p>{SITE.tagline}</p>
      <p>2020 至 2021 年的文章保留當時的觀點與紀錄，部分資訊可能已隨時間改變。</p>
      <div class="actions">
        <a class="btn" href="/blog/"><Icon name="book-open" size={17} />看看所有文章</a>
        <a class="btn ghost" href={SITE.github} rel="me noopener"><Icon name="github" size={17} />GitHub</a>
      </div>
    </div>
  </div>
</Base>
