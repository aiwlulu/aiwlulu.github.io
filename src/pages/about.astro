---
import Base from '../layouts/Base.astro';
import '../styles/article.css';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Route from '../components/Route.astro';
import { SITE } from '../site';
import { breadcrumbs, person } from '../schema';
const crumbs = [{ name: '首頁', href: '/' }, { name: '關於' }];
const profile = { '@context': 'https://schema.org', '@type': 'ProfilePage', inLanguage: SITE.lang, mainEntity: person };
const alternates = { 'zh-Hant-TW': '/about/', en: '/en/about/' };
---

<Base title="關於過鹿人" description="過鹿人：讀會計，但一路逃避做會計的軟體人。從財務系統顧問轉去寫程式，現在做軟體開發與系統整合。這裡記錄讀的書、聽的演講和好用的工具。" alternates={alternates} jsonLd={[profile, breadcrumbs(crumbs)]}>
  <div class="head wrap narrow">
    <Crumbs items={crumbs} />
    <h1>About Me</h1>
    <a class="btn ghost small lang-switch" href="/en/about/" hreflang="en" lang="en"><Icon name="languages" size={15} />English</a>
  </div>
  <div class="wrap">
    <div class="prose narrow" style="margin-inline:auto">
      <p class="about-line"><strong>讀會計，但一路逃避做會計的軟體人。</strong></p>
      <p>我是{SITE.author}，{SITE.tagline}。</p>
      <Route lang="zh" />
      <p>大學念的是會計資訊，畢業後沒有去記帳，而是去幫企業導入財務系統；後來乾脆學寫程式，從前端一路做到資料與系統整合。</p>
      <p>現在的工作，大多是先聽懂使用者怎麼做事，再把流程變成好用的工具。</p>
      <p>說是逃避會計，其實沒有逃太遠：寫的程式常常還是在處理帳、報表和數字，只是換成讓電腦來做。</p>
      <h2>這裡寫什麼</h2>
      <p>讀的書、聽的演講、用過覺得好用的工具，還有學習路上的想法。</p>
      <p>2020 至 2021 年的文章保留當時的觀點與紀錄，部分資訊可能已隨時間改變。</p>
      <div class="actions">
        <a class="btn" href="/blog/"><Icon name="book-open" size={17} />看看所有文章</a>
        <a class="btn ghost" href={SITE.github} target="_blank" rel="me noopener noreferrer"><Icon name="github" size={17} />GitHub</a>
      </div>
    </div>
  </div>
</Base>
