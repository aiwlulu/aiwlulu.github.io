---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import YouTube from '../../components/YouTube.astro';
import Icon from '../../components/Icon.astro';
import { SITE, getPosts, formatDate, readingMinutes, tagSlug, type Post } from '../../site';
import { breadcrumbs, blogPosting } from '../../schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { title, subtitle, description, pubDate, updatedDate, category, tags } = post.data;
const { Content, headings } = await render(post);
const sections = headings.filter((h) => h.depth === 2);
const crumbs = [{ name: '首頁', href: '/' }, { name: '文章', href: '/blog/' }, { name: title }];
const ageYears = new Date().getFullYear() - (updatedDate ?? pubDate).getFullYear();
---

<Base title={title} description={description} type="article" published={pubDate} modified={updatedDate} tags={tags} progress jsonLd={[blogPosting(post, '/og.png'), breadcrumbs(crumbs)]}>
  <article>
    <header class="head wrap narrow">
      <Crumbs items={crumbs} />
      <h1>{title}</h1>
      {subtitle && <p class="lede"><span class="marker">{subtitle}</span></p>}
      <div class="post-meta">
        <a class="pill" href={`/categories/${category}/`}><Icon name="folder" size={13} />{category}</a>
        <span class="meta"><Icon name="user-round" size={15} />{SITE.author}</span>
        <span class="meta"><Icon name="calendar" size={15} /><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
        <span class="meta"><Icon name="clock" size={15} />約 {readingMinutes(post)} 分鐘</span>
      </div>
    </header>
    <div class="wrap post-grid">
      {sections.length >= 3 && (
        <nav class="toc" aria-label="本文目錄">
          <h2>這篇會讀到</h2>
          <ol>
            {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="post-main">
        {ageYears >= 2 && <p class="note"><Icon name="info" size={17} /><span>這篇文章寫於 {pubDate.getFullYear()} 年，保留當時的觀點與紀錄，部分資訊可能已隨時間改變。</span></p>}
        <div class="prose">
          <Content components={{ YT: YouTube }} />
        </div>
        <footer class="post-foot">
          {tags.length > 0 && (
            <ul class="pills" aria-label="標籤">
              {tags.map((t) => <li><a class="pill tag" href={`/tags/${tagSlug(t)}/`}><Icon name="tag" size={13} />{t}</a></li>)}
            </ul>
          )}
          <div class="actions">
            <button class="btn ghost" type="button" data-copy-link><Icon name="link" size={16} class="when-idle" /><Icon name="check" size={16} class="when-done" /><span data-copy-label>複製連結</span></button>
            <a class="btn ghost" href="#main"><Icon name="arrow-up" size={16} />回到頂端</a>
          </div>
          <div class="author">
            <img src="/favicon.svg" alt="" width="56" height="56" loading="lazy" />
            <p><strong>{SITE.author}</strong><br />{SITE.tagline}</p>
            <a class="btn small" href="/about/">關於我<Icon name="arrow-right" size={15} /></a>
          </div>
          <nav class="pager" aria-label="上下篇">
            {older && <a class="prev" href={`/blog/${older.id}/`}><Icon name="chevron-left" size={20} /><span><small>上一篇</small>{older.data.title}</span></a>}
            {newer && <a class="next" href={`/blog/${newer.id}/`}><span><small>下一篇</small>{newer.data.title}</span><Icon name="chevron-right" size={20} /></a>}
          </nav>
        </footer>
      </div>
    </div>
  </article>
</Base>
