---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Topics from '../../components/Topics.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getPosts } from '../../site';
import { breadcrumbs, collectionPage } from '../../schema';
const posts = await getPosts();
const crumbs = [{ name: '首頁', href: '/' }, { name: '文章' }];
---

<Base title="文章" description={`過鹿人部落格的全部 ${posts.length} 篇文章，依發表時間由新到舊排列：讀書心得、TED 演講筆記、歷史與學習的思考，以及好用工具分享。`} jsonLd={[breadcrumbs(crumbs), collectionPage('文章', '/blog/', posts)]}>
  <div class="head wrap">
    <Crumbs items={crumbs} />
    <h1>文章</h1>
    <p class="lede">共 {posts.length} 篇，依發表時間由新到舊。</p>
  </div>
  <div class="wrap">
    <Topics current="/blog/" />
    <div class="grid">
      {posts.map((post, i) => <PostCard post={post} index={i} />)}
    </div>
  </div>
</Base>
