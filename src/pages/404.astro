---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="找不到頁面" description="這個網址沒有內容，可能是舊站的連結已經整理。請回到首頁或文章列表，繼續閱讀過鹿人部落格的文章。" noindex>
  <div class="head wrap">
    <h1>找不到這個頁面</h1>
    <p class="lede">網址可能已經變動。</p>
    <div class="actions" style="margin-top:24px">
      <a class="btn" href="/"><Icon name="house" size={17} />回到首頁</a>
      <a class="btn ghost" href="/blog/"><Icon name="book-open" size={17} />所有文章</a>
    </div>
  </div>
</Base>
