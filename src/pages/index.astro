---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Topics from '../components/Topics.astro';
import Icon from '../components/Icon.astro';
import { SITE, getPosts } from '../site';
import { website } from '../schema';
const posts = await getPosts();
---

<Base tallSky jsonLd={[website]}>
  <section class="hero wrap">
    <h1 aria-label={SITE.name}>{[...SITE.name].map((ch, i) => <span aria-hidden="true" style={`--i:${i}`}>{ch}</span>)}</h1>
    <p>{SITE.tagline}</p>
    <div class="hero-actions">
      <a class="btn" href="#latest"><Icon name="book-open" size={17} />開始閱讀</a>
      <a class="btn ghost" href="/about/"><Icon name="user-round" size={17} />關於我</a>
    </div>
  </section>
  <section class="wrap" aria-labelledby="latest">
    <h2 id="latest" class="section-title"><span class="marker">最新文章</span></h2>
    <Topics current="" />
    <div class="grid">
      {posts.map((post, i) => <PostCard post={post} heading="h3" featured={i === 0} index={i} />)}
    </div>
  </section>
</Base>
