---
// Lucide icons, inlined at build time from lucide-static (no client JS, no icon font).
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUp from 'lucide-static/icons/arrow-up.svg?raw';
import bookOpen from 'lucide-static/icons/book-open.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import chevronLeft from 'lucide-static/icons/chevron-left.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import folder from 'lucide-static/icons/folder.svg?raw';
import house from 'lucide-static/icons/house.svg?raw';
import info from 'lucide-static/icons/info.svg?raw';
import link from 'lucide-static/icons/link.svg?raw';
import play from 'lucide-static/icons/play.svg?raw';
import rss from 'lucide-static/icons/rss.svg?raw';
import tag from 'lucide-static/icons/tag.svg?raw';
import tags from 'lucide-static/icons/tags.svg?raw';
import userRound from 'lucide-static/icons/user-round.svg?raw';

const body = (svg: string) => svg.replace(/<!--[\s\S]*?-->/, '').replace(/<svg[^>]*>/, '').replace('</svg>', '').replace(/\s*\n\s*/g, '');
// Lucide no longer ships brand icons; this is its former GitHub mark.
const github = '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.500 3 5.500 6 5.500-.39.490-.68 1.050-.85 1.650-.17.6-.22 1.230-.15 1.850v4"/><path d="M9 18c-4.510 2-5-2-7-2"/>';
const icons = {
  'arrow-right': body(arrowRight), 'arrow-up': body(arrowUp), 'book-open': body(bookOpen), calendar: body(calendar), check: body(check),
  'chevron-left': body(chevronLeft), 'chevron-right': body(chevronRight), clock: body(clock), folder: body(folder), house: body(house),
  info: body(info), link: body(link), play: body(play), rss: body(rss), tag: body(tag), tags: body(tags), 'user-round': body(userRound), github,
};
interface Props { name: keyof typeof icons; size?: number; filled?: boolean; class?: string }
const { name, size = 18, filled = false, class: cls } = Astro.props;
---

<svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill={filled ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]} />
