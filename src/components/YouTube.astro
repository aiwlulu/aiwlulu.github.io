---
// Click-to-load YouTube embed: only a thumbnail is fetched until the visitor presses play.
import Icon from './Icon.astro';
interface Props { id: string; title?: string }
const { id, title = 'YouTube 影片' } = Astro.props;
---

<div class="yt" data-yt={id}>
  <a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer" aria-label={`播放${title}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <span class="yt-play"><Icon name="play" size={22} filled /></span>
  </a>
</div>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; margin: 2em 0; border: 10px solid #fff; border-radius: 6px; overflow: hidden; background: linear-gradient(100deg, var(--surface-2) 30%, #fff 50%, var(--surface-2) 70%) 0 0 / 300% 100%; box-shadow: var(--shadow-lift); transition: transform 0.4s var(--ease); }
  .yt:hover { transform: rotate(-0.6deg) scale(1.01); }
  .yt a, .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .yt img, .yt img:hover { width: 100%; height: 100%; object-fit: cover; margin: 0; padding: 0; border-radius: 0; box-shadow: none; rotate: 0deg; scale: 1; }
  .yt-play { position: absolute; inset: 0; margin: auto; width: 64px; height: 64px; display: grid; place-items: center; border-radius: 50%; background: var(--sun); color: var(--ink); padding-left: 3px; box-shadow: 0 5px 0 var(--sun-deep); transition: transform 0.35s var(--ease); }
  .yt a:hover .yt-play { transform: scale(1.18) rotate(-8deg); }
</style>
