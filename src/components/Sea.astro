---
// A live sea closes every page. The shader draws its own horizon and fades into the page sky.
// Gull silhouettes soar across above it.
import { SITE } from '../site';
import Icon from './Icon.astro';
interface Props { lang?: string }
const en = Astro.props.lang === 'en';
const t = en
  ? { footer: 'Footer', posts: 'Posts', about: 'About', party: 'Celebrate yourself', top: 'Back to top' }
  : { footer: '頁尾', posts: '文章', about: '關於', party: '為自己慶祝', top: '回到頂端' };
// Three gull silhouettes of different sizes cross the sky at their own pace, mostly gliding.
const gulls = [
  { top: 9, size: 46, cross: 64, delay: -20, flap: 5.2, bob: 8 },
  { top: 17, size: 32, cross: 80, delay: -52, flap: 4.4, bob: 10 },
  { top: 5, size: 22, cross: 98, delay: -74, flap: 3.8, bob: 12 },
];
const year = new Date().getFullYear();
// Fallback waves, shown only while the canvas is not drawing. Each strip repeats every half of
// its width, so sliding it by 50% loops.
const wave = (half: number, amp: number) => {
  let d = `M0 30Q${half / 2} ${30 - amp} ${half} 30`;
  for (let x = half * 2; x <= 2400; x += half) d += `T${x} 30`;
  return `${d}V240H0z`;
};
const fallback = [
  { cls: 'f1', d: wave(150, 14), dur: 44 },
  { cls: 'f2', d: wave(200, 18), dur: 32 },
  { cls: 'f3', d: wave(120, 14), dur: 24 },
  { cls: 'f4', d: wave(150, 18), dur: 18 },
];
---

<footer class="sea">
  <canvas class="sea-canvas" transition:persist="sea-canvas" aria-hidden="true"></canvas>
  <div class="sea-fallback" aria-hidden="true">
    {fallback.map((l) => (
      <svg class:list={['fwave', l.cls]} viewBox="0 0 2400 240" preserveAspectRatio="none" style={`animation-duration:${l.dur}s`}><path d={l.d} /></svg>
    ))}
  </div>
  <div class="sea-scene" aria-hidden="true">
    {gulls.map((g, i) => (
      <div class="flight" style={`top:${g.top}%;--i:${i};animation-duration:${g.cross}s;animation-delay:${g.delay}s`}>
        <svg class="gull" viewBox="-34 -18 68 30" width={g.size} style={`animation-duration:${g.bob}s`} fill="currentColor">
          <!-- Each wing is a tapered blade: thick at the shoulder, bending to a fine tip. -->
          <path class="wing left" d="M1 1C-6 -7 -15 -9 -22 -6-26 -4 -30 -1 -33 3-29 0 -25 -2 -21 -2.5-14 -3.5 -8 -1 -2 4z" style={`animation-duration:${g.flap}s`} />
          <path class="wing right" d="M-1 1C6 -7 15 -9 22 -6 26 -4 30 -1 33 3 29 0 25 -2 21 -2.5 14 -3.5 8 -1 2 4z" style={`animation-duration:${g.flap}s`} />
          <path d="M-5 1.5C-2 -1 3 -1 6 1.5L9 3.2 5 4C2 5.5 -2 5.5 -4.5 4z" />
        </svg>
      </div>
    ))}
  </div>
  <div class="sea-content wrap">
    <p class="sea-name">{SITE.name}</p>
    <nav class="sea-links" aria-label={t.footer}>
      <a href="/blog/"><Icon name="book-open" size={15} />{t.posts}</a>
      <a href={en ? '/en/about/' : '/about/'}><Icon name="user-round" size={15} />{t.about}</a>
      <a href="/rss.xml" data-astro-reload><Icon name="rss" size={15} />RSS</a>
      <a href={SITE.github} target="_blank" rel="me noopener noreferrer"><Icon name="github" size={15} />GitHub</a>
    </nav>
    <p class="sea-copy">© {year} {SITE.author}</p>
    <button class="sea-party" type="button" data-celebrate><Icon name="party-popper" size={18} />{t.party}</button>
    <a class="sea-top" href="#main" aria-label={t.top}><Icon name="arrow-up" size={18} /></a>
  </div>
</footer>

<script>
  import { mountScene } from '../scripts/scene';
  import frag from '../scripts/sea.frag';
  import { palette } from '../scripts/palette';
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.sea-canvas');
  if (canvas) mountScene(canvas, frag, {
    maxDpr: 1.25,
    fps: 30,
    uniforms: () => {
      const p = palette();
      return { uHorizon: p.horizon, uGlow: p.glow, uSeaFar: p.seaFar, uSeaMid: p.seaMid, uSeaNear: p.seaNear, uSeaLight: p.seaLight, uNight: p.night };
    },
  });
</script>

<style>
  .sea { position: relative; background: linear-gradient(to bottom, transparent 62%, var(--sea-5) 100%); height: clamp(400px, 58vh, 560px); margin-top: 72px; display: flex; align-items: flex-end; color: var(--on-sea); isolation: isolate; overflow: hidden; }
  .sea-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -3; -webkit-mask-image: linear-gradient(to bottom, transparent 4%, #000 30%); mask-image: linear-gradient(to bottom, transparent 4%, #000 30%); }
  .sea-scene { position: absolute; inset: 0; z-index: -2; }
  /* Moving paper waves stand in whenever WebGL is unavailable or the context has been lost. */
  .sea-fallback { position: absolute; inset: 0; z-index: -3; overflow: hidden; }
  .sea-canvas.is-live + .sea-fallback { display: none; }
  .fwave { position: absolute; left: 0; width: 200%; height: 100%; animation: slide linear infinite; }
  .fwave path { stroke: rgb(255 255 255 / 0.45); stroke-width: 3; vector-effect: non-scaling-stroke; }
  .f1 { top: 30%; fill: var(--sea-1); }
  .f2 { top: 44%; fill: var(--sea-2); animation-direction: reverse; }
  .f3 { top: 58%; fill: var(--sea-3); }
  .f4 { top: 72%; fill: var(--sea-4); animation-direction: reverse; }
  @keyframes slide { to { transform: translateX(-50%); } }
  /* Darkens the near water so the footer text stays readable. */
  .sea::after { content: ''; position: absolute; inset: auto 0 0 0; height: 42%; z-index: -1; background: linear-gradient(to bottom, transparent, rgb(13 62 110 / 0.7)); pointer-events: none; }

  .flight { position: absolute; left: 0; color: var(--ink); opacity: 0.82; animation: cross linear infinite; will-change: transform; transition: opacity 1s; }
  @keyframes cross { from { transform: translateX(-70px); } to { transform: translateX(100vw); } }
  /* Soaring: a slow rise and fall with a slight bank. */
  .gull { display: block; overflow: visible; animation: soar ease-in-out infinite; }
  @keyframes soar { 0%, 100% { transform: translateY(0) rotate(2deg); } 50% { transform: translateY(-12px) rotate(-4deg); } }
  /* Mostly gliding with wings held slightly up; now and then three unhurried beats. */
  .wing { transform-origin: 0 2px; transform-box: view-box; animation: beat ease-in-out infinite; }
  .wing.right { animation-name: beat-right; }
  @keyframes beat {
    0%, 58%, 100% { transform: rotate(-4deg); }
    64%, 78%, 92% { transform: rotate(-30deg) scaleX(0.94); }
    71%, 85% { transform: rotate(18deg) scaleX(0.9); }
  }
  @keyframes beat-right {
    0%, 58%, 100% { transform: rotate(4deg); }
    64%, 78%, 92% { transform: rotate(30deg) scaleX(0.94); }
    71%, 85% { transform: rotate(-18deg) scaleX(0.9); }
  }
  /* Gulls roost at night. */
  :global([data-theme='dark']) .flight { opacity: 0; }

  .sea-content { width: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; padding-bottom: 26px; text-shadow: 0 1px 8px rgb(8 40 76 / 0.45); }
  .sea-name { margin: 0; font-weight: 900; font-size: 17px; letter-spacing: 0.04em; }
  .sea-links { display: flex; flex-wrap: wrap; gap: 4px 6px; margin-right: auto; }
  .sea-links a { display: inline-flex; align-items: center; gap: 6px; color: inherit; text-decoration: none; padding: 6px 12px; border-radius: 999px; font-size: 14.5px; transition: background 0.2s, transform 0.3s var(--ease); }
  .sea-links a:hover { background: rgb(255 255 255 / 0.2); transform: translateY(-2px); }
  .sea-copy { margin: 0; font-size: 13.5px; }
  .sea-party, .sea-top { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; border: 0; border-radius: 999px; color: var(--on-accent); background: var(--sun); box-shadow: 0 4px 0 var(--sun-deep); font: inherit; font-size: 15px; font-weight: 900; letter-spacing: 0.04em; text-shadow: none; cursor: pointer; transition: transform 0.3s var(--ease), box-shadow 0.2s; }
  .sea-party { padding: 0 20px; background: var(--coral); box-shadow: 0 4px 0 #cf6c48; }
  .sea-top { width: 44px; }
  .sea-party:hover { transform: translateY(-4px) rotate(-3deg); box-shadow: 0 8px 0 #cf6c48; }
  .sea-party:hover :global(.icon) { animation: wiggle 0.5s ease-in-out infinite; }
  .sea-party:active { transform: translateY(3px); box-shadow: 0 1px 0 #cf6c48; }
  .sea-top:hover { transform: translateY(-4px) rotate(-8deg); box-shadow: 0 8px 0 var(--sun-deep); }
  .sea-top:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--sun-deep); }
  @keyframes wiggle { 0%, 100% { transform: rotate(-12deg); } 50% { transform: rotate(14deg) scale(1.15); } }
</style>
