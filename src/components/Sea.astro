---
import { SITE } from '../site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="sea">
  <canvas class="sea-canvas" aria-hidden="true"></canvas>
  <div class="sea-content wrap">
    <p class="sea-name">{SITE.name}</p>
    <nav class="sea-links" aria-label="頁尾">
      <a href="/blog/"><Icon name="book-open" size={15} />文章</a>
      <a href="/about/"><Icon name="user-round" size={15} />關於</a>
      <a href="/rss.xml"><Icon name="rss" size={15} />RSS</a>
      <a href={SITE.github} rel="me noopener"><Icon name="github" size={15} />GitHub</a>
    </nav>
    <p class="sea-copy">© {SITE.since}-{year} {SITE.author}</p>
    <a class="sea-top" href="#main" aria-label="回到頂端"><Icon name="arrow-up" size={18} /></a>
  </div>
</footer>

<script>
  import { mountScene } from '../scripts/scene';
  import frag from '../scripts/sea.frag';
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.sea-canvas');
  if (canvas) mountScene(canvas, frag);
</script>

<style>
  .sea {
    position: relative;
    height: clamp(420px, 62vh, 620px);
    margin-top: 96px;
    display: flex;
    align-items: flex-end;
    color: var(--on-sea);
    isolation: isolate;
  }
  .sea-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    background: linear-gradient(to bottom, var(--page) 0%, var(--sky-low) 30%, var(--sea-light) 34%, var(--sea) 60%, var(--sea-deep) 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 26%);
    mask-image: linear-gradient(to bottom, transparent, #000 26%);
  }
  /* Darkens the near water so the footer text stays readable. */
  .sea::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    z-index: -1;
    background: linear-gradient(to bottom, transparent, rgb(13 62 110 / 0.72));
  }
  .sea-content {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
    padding-bottom: 28px;
    text-shadow: 0 1px 8px rgb(8 40 76 / 0.45);
  }
  .sea-name { margin: 0; font-weight: 900; font-size: 17px; letter-spacing: 0.02em; }
  .sea-links { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-right: auto; }
  .sea-links a { display: inline-flex; align-items: center; gap: 6px; color: inherit; text-decoration: none; padding: 6px 0; font-size: 14.5px; }
  .sea-links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .sea-copy { margin: 0; font-size: 13.5px; opacity: 0.92; }
  .sea-top { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: inherit; background: rgb(255 255 255 / 0.16); border: 1px solid rgb(255 255 255 / 0.45); backdrop-filter: blur(6px); transition: background 0.2s, transform 0.2s; }
  .sea-top:hover { background: rgb(255 255 255 / 0.3); transform: translateY(-3px); }
</style>
