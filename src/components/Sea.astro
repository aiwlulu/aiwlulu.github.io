---
// A live sea closes every page. The shader draws its own horizon and fades into the page sky.
// Two hand-drawn gulls are pasted on top, collage style.
import { SITE } from '../site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="sea" transition:persist="sea">
  <canvas class="sea-canvas" aria-hidden="true"></canvas>
  <div class="sea-scene" aria-hidden="true">
    <svg class="gull g1" viewBox="0 0 60 24" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16q10-14 26 0 16-14 26 0" /></svg>
    <svg class="gull g2" viewBox="0 0 60 24" fill="none" stroke="var(--ink)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16q10-14 26 0 16-14 26 0" /></svg>
  </div>
  <div class="sea-content wrap">
    <p class="sea-name">{SITE.name}</p>
    <nav class="sea-links" aria-label="頁尾">
      <a href="/blog/"><Icon name="book-open" size={15} />文章</a>
      <a href="/about/"><Icon name="user-round" size={15} />關於</a>
      <a href="/rss.xml" data-astro-reload><Icon name="rss" size={15} />RSS</a>
      <a href={SITE.github} target="_blank" rel="me noopener noreferrer"><Icon name="github" size={15} />GitHub</a>
    </nav>
    <p class="sea-copy">© {SITE.since}-{year} {SITE.author}</p>
    <button class="sea-party" type="button" data-celebrate><Icon name="party-popper" size={18} />為自己慶祝</button>
    <a class="sea-top" href="#main" aria-label="回到頂端"><Icon name="arrow-up" size={18} /></a>
  </div>
</footer>

<script>
  import { mountScene } from '../scripts/scene';
  import frag from '../scripts/sea.frag';
  import { palette } from '../scripts/palette';
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.sea-canvas');
  if (canvas) mountScene(canvas, frag, {
    maxDpr: 1.25,
    fps: 30,
    uniforms: () => {
      const p = palette();
      return { uHorizon: p.horizon, uGlow: p.glow, uSeaFar: p.seaFar, uSeaMid: p.seaMid, uSeaNear: p.seaNear, uSeaLight: p.seaLight };
    },
  });
</script>

<style>
  .sea { position: relative; height: clamp(400px, 58vh, 560px); margin-top: 72px; display: flex; align-items: flex-end; color: var(--on-sea); isolation: isolate; overflow: hidden; }
  .sea-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -3; background: linear-gradient(to bottom, transparent 30%, var(--sea-1) 34%, var(--sea-3) 62%, var(--sea-5) 100%); -webkit-mask-image: linear-gradient(to bottom, transparent 4%, #000 30%); mask-image: linear-gradient(to bottom, transparent 4%, #000 30%); }
  .sea-scene { position: absolute; inset: 0; z-index: -2; }
  /* Darkens the near water so the footer text stays readable. */
  .sea::after { content: ''; position: absolute; inset: auto 0 0 0; height: 42%; z-index: -1; background: linear-gradient(to bottom, transparent, rgb(13 62 110 / 0.7)); pointer-events: none; }

  .gull { position: absolute; width: 38px; transition: stroke 1s; animation: glide 14s ease-in-out infinite; }
  :global([data-tone='dark']) .gull { stroke: var(--cloud); }
  .g1 { top: 8%; left: 16%; }
  .g2 { top: 15%; left: 24%; width: 26px; animation-delay: -5s; }
  @keyframes glide { 50% { transform: translate(26px, -10px) rotate(4deg); } }

  .sea-content { width: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; padding-bottom: 26px; text-shadow: 0 1px 8px rgb(8 40 76 / 0.45); }
  .sea-name { margin: 0; font-weight: 900; font-size: 17px; letter-spacing: 0.04em; }
  .sea-links { display: flex; flex-wrap: wrap; gap: 4px 6px; margin-right: auto; }
  .sea-links a { display: inline-flex; align-items: center; gap: 6px; color: inherit; text-decoration: none; padding: 6px 12px; border-radius: 999px; font-size: 14.5px; transition: background 0.2s, transform 0.3s var(--ease); }
  .sea-links a:hover { background: rgb(255 255 255 / 0.2); transform: translateY(-2px); }
  .sea-copy { margin: 0; font-size: 13.5px; }
  .sea-party, .sea-top { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; border: 0; border-radius: 999px; color: var(--ink); background: var(--sun); box-shadow: 0 4px 0 var(--sun-deep); font: inherit; font-size: 15px; font-weight: 900; letter-spacing: 0.04em; text-shadow: none; cursor: pointer; transition: transform 0.3s var(--ease), box-shadow 0.2s; }
  .sea-party { padding: 0 20px; background: var(--coral); box-shadow: 0 4px 0 #cf6c48; }
  .sea-top { width: 44px; }
  .sea-party:hover { transform: translateY(-4px) rotate(-3deg); box-shadow: 0 8px 0 #cf6c48; }
  .sea-party:hover :global(.icon) { animation: wiggle 0.5s ease-in-out infinite; }
  .sea-party:active { transform: translateY(3px); box-shadow: 0 1px 0 #cf6c48; }
  .sea-top:hover { transform: translateY(-4px) rotate(-8deg); box-shadow: 0 8px 0 var(--sun-deep); }
  .sea-top:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--sun-deep); }
  @keyframes wiggle { 0%, 100% { transform: rotate(-12deg); } 50% { transform: rotate(14deg) scale(1.15); } }
</style>
