---
// Index of all categories or all tags.
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import { breadcrumbs } from '../schema';
interface Props { title: string; description: string; items: { name: string; href: string; count: number }[] }
const { title, description, items } = Astro.props;
const crumbs = [{ name: '首頁', href: '/' }, { name: '文章', href: '/blog/' }, { name: title }];
---

<Base title={title} description={description} jsonLd={[breadcrumbs(crumbs)]}>
  <div class="head wrap">
    <Crumbs items={crumbs} />
    <h1>{title}</h1>
  </div>
  <div class="wrap">
    <ul class="pills">
      {items.map((i) => <li><a class="pill tag" style="font-size:15.5px;padding:8px 18px" href={i.href}>{i.name}<span class="n">{i.count}</span></a></li>)}
    </ul>
  </div>
</Base>
