---
import { SITE, getPosts, countBy, tagSlug } from '../site';
import Icon from './Icon.astro';
const posts = await getPosts();
const categories = countBy(posts, (p) => [p.data.category]);
const tags = countBy(posts, (p) => p.data.tags);
---

<aside class="side">
  <section class="panel">
    <h2><Icon name="user-round" size={14} />About Me</h2>
    <p><strong>{SITE.author}</strong></p>
    <p>{SITE.tagline}</p>
    <a class="btn ghost small" href="/about/">Know More<Icon name="arrow-right" size={15} /></a>
  </section>
  <section class="panel">
    <h2><Icon name="folder" size={14} />Category</h2>
    <ul class="pills">
      {categories.map(([c, n]) => <li><a class="pill" href={`/categories/${c}/`}>{c}<span class="n">{n}</span></a></li>)}
    </ul>
  </section>
  <section class="panel">
    <h2><Icon name="tags" size={14} />Tag</h2>
    <ul class="pills">
      {tags.map(([t, n]) => <li><a class="pill" href={`/tags/${tagSlug(t)}/`}>{t}<span class="n">{n}</span></a></li>)}
    </ul>
  </section>
</aside>
