---
import { formatDate, readingMinutes, topicIcon, type Post } from '../site';
import Icon from './Icon.astro';
interface Props { post: Post; heading?: 'h2' | 'h3'; featured?: boolean; index?: number }
const { post, heading: H = 'h2', featured = false, index = 0 } = Astro.props;
const { title, subtitle, description, pubDate, category } = post.data;
---

<article class:list={['card', 'reveal', { featured }]} style={`--i:${index}`}>
  <div class="card-meta">
    <a class="pill" href={`/categories/${category}/`}><Icon name={topicIcon(category, 'folder')} size={13} />{category}</a>
    <span class="meta"><Icon name="calendar" size={14} /><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
    <span class="meta"><Icon name="clock" size={14} />約 {readingMinutes(post)} 分鐘</span>
  </div>
  <H class="card-title"><a href={`/blog/${post.id}/`}>{title}</a></H>
  {subtitle && <p class="card-sub">{subtitle}</p>}
  <p class="card-desc">{description}</p>
  <span class="card-more" aria-hidden="true">閱讀全文<Icon name="arrow-right" size={16} /></span>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; background: var(--surface); border-radius: var(--radius); padding: 28px 30px 24px; box-shadow: var(--shadow); }
  .card.in { transition: opacity 0.6s ease-out, transform 0.45s var(--ease), box-shadow 0.3s; }
  .card:hover { transform: translateY(-6px) rotate(-0.6deg); box-shadow: var(--shadow-lift); }
  .card:nth-child(even):hover { transform: translateY(-6px) rotate(0.6deg); }
  /* A strip of tape holds each card to the page. */
  .card::before { content: ''; position: absolute; top: -11px; left: 34px; width: 84px; height: 24px; rotate: -4deg; background: rgb(255 203 61 / 0.78); border-radius: 2px; transition: rotate 0.4s var(--ease), translate 0.4s var(--ease); }
  .card:nth-child(3n + 2)::before { background: rgb(239 143 107 / 0.7); left: auto; right: 40px; rotate: 3deg; }
  .card:nth-child(3n)::before { background: rgb(168 201 160 / 0.85); rotate: 2deg; }
  .card:hover::before { rotate: 6deg; translate: 0 -2px; }
  .card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 13.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .card-meta .pill { position: relative; z-index: 1; }
  .card-title { margin: 14px 0 6px; font-size: 22px; line-height: 1.45; color: var(--ink); letter-spacing: 0.01em; }
  .card-title a { color: inherit; text-decoration: none; background: linear-gradient(var(--mark), var(--mark)) 0 92% / 0 8px no-repeat; transition: background-size 0.35s ease-out; }
  .card:hover .card-title a { background-size: 100% 8px; }
  /* Whole card is clickable through the title link. */
  .card-title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .card-sub { margin: 0; color: var(--ink); font-weight: 700; }
  .card-desc { margin: 8px 0 0; font-size: 15px; line-height: 1.8; color: var(--text); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-more { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 18px; font-size: 14px; font-weight: 900; color: var(--ink); }
  .card-more :global(svg) { transition: transform 0.35s var(--ease); }
  .card:hover .card-more :global(svg) { transform: translateX(7px); }
  .card.featured { grid-column: 1 / -1; padding: 36px 40px 30px; }
  .card.featured .card-title { font-size: clamp(24px, 3.2vw, 31px); }
  .card.featured .card-desc { font-size: 16px; max-width: 42em; }
  @media (max-width: 560px) { .card, .card.featured { padding: 26px 22px 22px; } }
</style>
