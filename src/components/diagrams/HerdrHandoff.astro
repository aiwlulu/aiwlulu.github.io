---
// The proofreading example from the article, from request to reply.
// The three steps play in order, on a loop.
import Diagram from './Diagram.astro';
import Box from './parts/Box.astro';
import Arrow from './parts/Arrow.astro';
import Step from './parts/Step.astro';
const cycle = 7;
---

<Diagram
  title="Claude Code 透過 Herdr 請 Codex 校稿"
  description="Claude Code 在終端 t1 用 hc send blog 送出校稿請求。Codex 在終端 blog 讀取草稿開頭，再用 hc send t1 回傳一句修改建議。"
  height={284}
>
  <line class="dg-life" x1="84" y1="68" x2="84" y2="268" />
  <line class="dg-life" x1="316" y1="68" x2="316" y2="268" />

  <Box x={24} y={18} w={120} label="Claude Code" sub="終端 t1" strong />
  <Box x={256} y={18} w={120} label="Codex" sub="終端 blog" strong />

  <!-- 1: the request goes across. Each numbered dot sits where that step starts. -->
  <text class="dg-label" x="200" y="100"><tspan class="dg-code">hc send blog</tspan>　送出校稿請求</text>
  <Arrow d="M98 122H308" travel={{ at: 0.4, cycle }} />
  <Step x={84} y={122} n={1} pulse={{ at: 0.2, cycle }} />

  <!-- 2: Codex opens the draft -->
  <rect class="dg-note" x="262" y="148" width="108" height="40" rx="14" />
  <text class="dg-label" x="321" y="168">讀草稿開頭</text>
  <Step x={262} y={168} n={2} pulse={{ at: 2.4, cycle }} />

  <!-- 3: the result comes back, dashed because it is a reply -->
  <text class="dg-label" x="200" y="218"><tspan class="dg-code">hc send t1</tspan>　回傳修改建議</text>
  <Arrow d="M302 240H92" dashed travel={{ at: 4.2, cycle }} />
  <Step x={316} y={240} n={3} pulse={{ at: 4, cycle }} />
</Diagram>
