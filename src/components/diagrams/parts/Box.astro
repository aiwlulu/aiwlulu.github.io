---
// A labelled box. `strong` gives it the blue outline used for the things a diagram is about.
// `code` is set in monospace after the label; `sub` is a smaller second line.
interface Props { x: number; y: number; w: number; h?: number; label: string; code?: string; sub?: string; strong?: boolean; small?: boolean }
const { x, y, w, h = 50, label, code, sub, strong = false, small = false } = Astro.props;
const cx = x + w / 2;
const cy = y + h / 2;
---

<rect class:list={['dg-box', { 'is-strong': strong }]} x={x} y={y} width={w} height={h} rx={small ? 12 : 14} />
<text class:list={[{ 'dg-label': small }]} x={cx} y={sub ? cy - 11 : cy}>{label}{code && <> <tspan class="dg-code">{code}</tspan></>}</text>
{sub && <text class="dg-sub" x={cx} y={cy + 12}>{sub}</text>}
