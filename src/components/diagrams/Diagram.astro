---
// Frame for a hand-drawn SVG diagram. The drawing uses the site's colour variables, so it follows
// the light and dark themes, needs no library and is there on first paint.
// Click or press Enter to open it larger (handled with images in src/scripts/interactions.ts).
interface Props {
  /** Short title, read by screen readers and shown under the enlarged view. */
  title: string;
  /** One or two sentences saying what the diagram shows, for people who cannot see it. */
  description: string;
  /** viewBox size. 400 wide by default: narrow enough to stay readable on a phone without scrolling sideways. */
  width?: number;
  height: number;
}
const { title, description, width = 400, height } = Astro.props;
const id = `dg-${title.replace(/[^\p{L}\p{N}]+/gu, '-')}`;
---

<figure class="post-diagram" data-zoom-diagram={title} role="button" tabindex="0" aria-label={`放大圖表：${title}`}>
  <svg class="diagram" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{title}</title>
    <desc id={`${id}-d`}>{description}</desc>
    <defs>
      <marker id={`${id}-arrow`} class="dg-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0.8 9 5 0 9.2z" />
      </marker>
    </defs>
    <!-- Lines in this drawing point at the arrow with style="marker-end:var(--dg-arrow)". -->
    <g style={`--dg-arrow:url(#${id}-arrow)`}>
      <slot />
    </g>
  </svg>
</figure>

<style is:global>
  /* Hand-drawn diagrams. Class names start with dg-. */
  /* Drawn 400 wide and capped at 520px, so the lettering is about the size of body text on a
     desktop and still legible when the whole drawing shrinks to fit a phone. */
  .post-diagram svg.diagram { min-width: 0; max-width: 520px; font-family: var(--font); }
  .diagram text { fill: var(--ink); font-size: 15px; text-anchor: middle; dominant-baseline: central; }
  .diagram .dg-sub { fill: var(--text); font-size: 12.5px; }
  .diagram .dg-caption { fill: var(--muted); font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-anchor: start; }
  .diagram .dg-label { font-size: 13px; font-weight: 700; }
  .diagram .dg-code { font-family: var(--mono); font-size: 0.86em; font-weight: 400; }
  /* Boxes: a plain one for things people touch, an outlined one for where the work runs. */
  .diagram .dg-box { fill: var(--surface); stroke: var(--line-2); stroke-width: 1.5; }
  .diagram .dg-box.is-strong { stroke: var(--accent); stroke-width: 2; }
  .diagram .dg-note { fill: var(--sage-tint); stroke: var(--sage); stroke-width: 1.5; }
  .diagram .dg-chip { fill: var(--surface); stroke: var(--line); stroke-width: 1; }
  /* A room (a dashed outline) and its door plate. */
  .diagram .dg-room { fill: color-mix(in srgb, var(--surface) 55%, transparent); stroke: var(--line-2); stroke-width: 1.5; stroke-dasharray: 5 6; }
  .diagram .dg-plate { fill: var(--sun); }
  .diagram .dg-on-plate { fill: var(--on-accent); }
  .diagram .dg-line { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; marker-end: var(--dg-arrow); }
  .diagram .dg-line.is-dashed { stroke-dasharray: 2 7; }
  .diagram .dg-life { stroke: var(--line-2); stroke-width: 2; stroke-linecap: round; }
  .diagram .dg-arrow path { fill: var(--accent); }
  .diagram .dg-step circle { fill: var(--sun); }
  .diagram .dg-step text { fill: var(--on-accent); font-size: 12.5px; font-weight: 900; }
</style>
