---
// Herdr: where you look (the apps) and where the work runs (herdr-core on each machine).
import Diagram from './Diagram.astro';
import Box from './parts/Box.astro';
import Arrow from './parts/Arrow.astro';
import Chip from './parts/Chip.astro';
---

<Diagram
  title="Herdr App 的終端與執行主機"
  description="桌面 App 可以連到本機的 herdr-core，也可以透過 SSH 連到遠端的 herdr-core；手機 App 透過 SSH 連到遠端。終端和裡面的程式由各台機器上的 herdr-core 持有。"
  height={296}
>
  <text class="dg-caption" x="24" y="18">你看進度的地方</text>
  <text class="dg-caption" x="24" y="282">工作實際執行的地方</text>

  <!-- Each line leaves and arrives straight; only the desktop-to-remote link needs one step. -->
  <Arrow d="M100 84V192" flow />
  <Arrow d="M168 84V122Q168 134 180 134H238Q250 134 250 146V192" flow />
  <Arrow d="M319 84V192" flow />

  <Box x={24} y={32} w={166} h={52} label="桌面 App" />
  <Box x={262} y={32} w={114} h={52} label="手機 App" />

  <!-- Labels sit beside their lines, never on top of the stroke. -->
  <Chip x={133} y={152} text="本機" />
  <Chip x={209} y={116} text="SSH" />
  <Chip x={351} y={138} text="SSH" />

  <Box x={24} y={196} w={152} h={68} label="本機" code="herdr-core" sub="終端、Agent" strong />
  <Box x={208} y={196} w={168} h={68} label="遠端" code="herdr-core" sub="Agent、測試" strong />
</Diagram>
