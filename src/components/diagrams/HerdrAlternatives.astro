---
import herdr from '../../assets/posts/herdr-tools/herdr.png';
import tmux from '../../assets/posts/herdr-tools/tmux.png';
import zellij from '../../assets/posts/herdr-tools/zellij.png';
import cmux from '../../assets/posts/herdr-tools/cmux.png';

// Official marks from herdr.dev/live/icons/herdr.png, tmux/tmux's logo directory,
// zellij.dev/img/logo.png and cmux.com/logo.png.
const rows = [
  { name: 'Herdr App／Core', mark: herdr, interface: '桌面', platforms: 'macOS、Linux、Windows', mobile: 'iPhone、iPad、Android', use: '跨裝置查看多台主機，並用 hc send 交接。', href: 'https://herdr.dev/download/', featured: true },
  { name: 'Herdr TUI', mark: herdr, interface: '終端', platforms: 'macOS、Linux、Windows', use: '離開終端後繼續跑，也能看 Agent 狀態和送指令。', href: 'https://herdr.dev/tui/docs/install/', featured: true },
  { name: 'tmux', mark: tmux, interface: '終端', platforms: 'macOS、Linux、Windows（透過 WSL）', use: '沿用既有的工作階段、腳本與按鍵。', href: 'https://github.com/tmux/tmux/wiki/Getting-Started', wordmark: true },
  { name: 'Zellij', mark: zellij, interface: '終端、桌面', platforms: 'macOS、Linux、Windows', use: '有操作提示，可還原佈局。桌面版也能集中看通知。', href: 'https://zellij.dev/documentation/installation' },
  { name: 'cmux 桌面版', mark: cmux, interface: '桌面', platforms: 'macOS', use: '同一視窗看瀏覽器、終端和通知。', href: 'https://cmux.com/docs' },
  { name: 'cmux TUI', mark: cmux, interface: '終端', platforms: 'macOS、Linux、Windows', use: '在終端切換工作區、分頁和窗格。', href: 'https://cmux.com/docs/tui' },
];
---

<div class="comparison">
  <table class="tool-table" aria-label="Herdr 與同類工具的介面、平台與用途">
    <colgroup><col class="tool-name" /><col class="tool-platform" /><col /></colgroup>
    <thead>
      <tr><th scope="col">工具</th><th scope="col">介面與支援平台</th><th scope="col">適合怎麼用</th></tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class:list={{ featured: row.featured }}>
          <th scope="row">
            <a class="tool-brand" href={row.href}>
              <img class:list={['tool-mark', { wordmark: row.wordmark }]} src={row.mark.src} width={row.mark.width} height={row.mark.height} alt={row.wordmark ? row.name : ''} loading="lazy" decoding="async" />
              {!row.wordmark && <span>{row.name}</span>}
            </a>
          </th>
          <td>
            <b>{row.interface}</b>
            <span>{row.platforms}</span>
            {row.mobile && <span>行動端 {row.mobile}</span>}
          </td>
          <td>{row.use}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="platform-note"><a href="https://learn.microsoft.com/zh-tw/windows/wsl/about">WSL</a> 是 Windows 的 Linux 子系統。Herdr App 的 macOS 版支援 Apple 晶片。</p>
</div>

<style>
  .comparison { margin: 1.8em 0; }
  .comparison .tool-table { table-layout: fixed; min-width: 0; margin: 0; }
  .tool-name { width: 28%; }
  .tool-platform { width: 36%; }
  .comparison :is(th, td) { white-space: normal; overflow-wrap: anywhere; }
  .comparison thead th { background: var(--ink); color: var(--surface); }
  .comparison tbody th { background: transparent; border-bottom: 0; }
  .comparison tbody tr + tr th { border-top: 1px solid var(--line); }
  .comparison tbody tr.featured { background: var(--sky-2); }
  .comparison .tool-brand { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35em 0.5em; text-decoration-thickness: 1px; }
  .comparison .tool-brand.external::after { display: none; }
  .comparison .tool-mark { display: block; width: 1.55em; height: 1.55em; object-fit: contain; margin: 0; padding: 0; border-radius: 0; background: none; box-shadow: none; rotate: none; animation: none; }
  .comparison .wordmark { width: 4em; }
  .comparison td:nth-child(2) > :is(b, span) { display: block; }
  .comparison .platform-note { margin: 0.6em 0 0; font-size: 0.84em; color: var(--muted); }

  @media (max-width: 520px) {
    .comparison .tool-table { font-size: 0.78em; line-height: 1.45; }
    .comparison :is(th, td) { padding: 0.65em 0.42em; }
    .comparison .tool-brand { flex-direction: column; align-items: flex-start; }
  }
</style>
