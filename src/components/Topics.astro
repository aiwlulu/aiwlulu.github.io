---
// One compact row of topic filters above a post list. Tags that only have a single post are
// left out here (they would each lead to a one-item page) and stay reachable from /tags/.
import { getPosts, countBy, tagSlug } from '../site';
import Icon from './Icon.astro';
interface Props { current?: string }
const { current = '/blog/' } = Astro.props;
const posts = await getPosts();
const categories = countBy(posts, (p) => [p.data.category]);
const tags = countBy(posts, (p) => p.data.tags).filter(([, n]) => n > 1);
const items = [
  { href: '/blog/', label: '全部', count: posts.length, icon: 'book-open' as const },
  ...categories.map(([c, n]) => ({ href: `/categories/${c}/`, label: c, count: n, icon: 'folder' as const })),
  ...tags.map(([t, n]) => ({ href: `/tags/${tagSlug(t)}/`, label: t, count: n, icon: 'tag' as const })),
];
---

<nav class="topics" aria-label="主題">
  {items.map((i) => (
    <a class="chip" href={i.href} aria-current={decodeURI(current) === i.href ? 'page' : undefined}>
      <Icon name={i.icon} size={14} />{i.label}<span class="n">{i.count}</span>
    </a>
  ))}
  <a class="chip more" href="/tags/"><Icon name="tags" size={14} />所有標籤</a>
</nav>

<style>
  .topics { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .chip { display: inline-flex; align-items: center; gap: 7px; min-height: 38px; padding: 6px 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); color: var(--ink); font-size: 14.5px; font-weight: 700; text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; }
  .chip:hover { border-color: var(--brand); box-shadow: var(--shadow); transform: translateY(-1px); }
  .chip[aria-current='page'] { background: var(--link); border-color: var(--link); color: #fff; }
  .chip .n { font-weight: 400; color: var(--muted); font-variant-numeric: tabular-nums; }
  .chip[aria-current='page'] .n { color: rgb(255 255 255 / 0.85); }
  .chip.more { background: transparent; border-style: dashed; border-color: var(--line-2); color: var(--text); font-weight: 400; }
  .chip :global(.icon) { opacity: 0.8; }
</style>
