---
// One compact row of topic filters above a post list. Tags that only have a single post are
// left out here (they would each lead to a one-item page) and stay reachable from /tags/.
import { getPosts, countBy, tagSlug, topicIcon } from '../site';
import Icon from './Icon.astro';
interface Props { current?: string }
const { current = '/blog/' } = Astro.props;
const posts = await getPosts();
const categories = countBy(posts, (p) => [p.data.category]);
const tags = countBy(posts, (p) => p.data.tags).filter(([, n]) => n > 1);
const items = [
  { href: '/blog/', label: '全部', count: posts.length, icon: 'book-open' as const },
  ...categories.map(([c, n]) => ({ href: `/categories/${c}/`, label: c, count: n, icon: topicIcon(c, 'folder') })),
  ...tags.map(([t, n]) => ({ href: `/tags/${tagSlug(t)}/`, label: t, count: n, icon: topicIcon(t, 'tag') })),
];
---

<nav class="topics" aria-label="主題">
  {items.map((i) => (
    <a class="chip" href={i.href} aria-current={decodeURI(current) === i.href ? 'page' : undefined}>
      <Icon name={i.icon} size={14} />{i.label}<span class="n">{i.count}</span>
    </a>
  ))}
  <a class="chip more" href="/tags/"><Icon name="tags" size={14} />所有標籤</a>
</nav>

<style>
  .topics { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 34px; }
  .chip { display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 6px 16px; border-radius: 999px; background: var(--surface); box-shadow: 0 3px 0 var(--line-2); color: var(--ink); font-size: 14.5px; font-weight: 700; text-decoration: none; transition: transform 0.3s var(--ease), box-shadow 0.2s, background 0.2s; }
  .chip:hover { transform: translateY(-3px) rotate(-2deg); box-shadow: 0 6px 0 var(--line-2); }
  .chip:nth-child(even):hover { transform: translateY(-3px) rotate(2deg); }
  .chip:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--line-2); }
  .chip[aria-current='page'] { background: var(--sun); box-shadow: 0 3px 0 var(--sun-deep); }
  .chip .n { font-weight: 400; color: var(--muted); font-variant-numeric: tabular-nums; }
  .chip[aria-current='page'] .n { color: var(--ink); }
  .chip.more { background: transparent; box-shadow: none; outline: 2px dashed var(--line-2); outline-offset: -2px; color: var(--text); font-weight: 400; }
  .chip.more:hover { background: var(--surface); box-shadow: none; }
  .chip :global(.icon) { opacity: 0.8; transition: transform 0.4s var(--ease); }
  .chip:hover :global(.icon) { transform: rotate(-12deg) scale(1.15); }
</style>
