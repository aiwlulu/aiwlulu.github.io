---
// Cut-paper sky: a sun, drifting clouds and a few hand-drawn marks. Pure SVG and CSS.
// The element persists across page navigations so the clouds never jump; its height
// follows <body data-sky>.
interface Props { tall?: boolean }
const { tall = false } = Astro.props;
const clouds = [
  { cls: 'c1', top: 14, width: 250, dur: 150, delay: -30 },
  { cls: 'c2', top: 40, width: 190, dur: 110, delay: -75 },
  { cls: 'c3', top: 8, width: 150, dur: 190, delay: -120 },
  { cls: 'c4', top: 58, width: 300, dur: 170, delay: -110 },
  { cls: 'c5', top: 30, width: 120, dur: 130, delay: -8 },
];
---

<div class:list={['sky', { 'is-tall': tall }]} transition:persist="sky" aria-hidden="true">
  <svg width="0" height="0" style="position:absolute">
    <symbol id="cloud" viewBox="0 0 200 92">
      <path d="M32 88a27 27 0 0 1 2-54 38 38 0 0 1 70-16 30 30 0 0 1 54 14 27 27 0 0 1 10 56z" />
    </symbol>
  </svg>

  <div class="sky-layer" data-depth="10">
    <span class="dots"></span>
    <svg class="sun" viewBox="0 0 140 140">
      <g class="rays" stroke="var(--sun)" stroke-width="5" stroke-linecap="round">
        {Array.from({ length: 12 }, (_, i) => <line x1="70" y1="8" x2="70" y2="20" transform={`rotate(${i * 30} 70 70)`} />)}
      </g>
      <circle cx="70" cy="70" r="36" fill="var(--sun)" />
    </svg>
    <svg class="mark squiggle" viewBox="0 0 120 30" fill="none" stroke="var(--coral)" stroke-width="6" stroke-linecap="round"><path d="M6 20q13-22 27 0t27 0 27 0 27 0" pathLength="1" /></svg>
    <svg class="mark arc" viewBox="0 0 90 90" fill="none" stroke="var(--sun)" stroke-width="9" stroke-linecap="round"><path d="M10 80C14 40 42 14 80 10" pathLength="1" /></svg>
    <span class="blob"></span>
  </div>

  <div class="sky-layer" data-depth="22">
    {clouds.map((c) => (
      <svg class:list={['cloud', c.cls]} viewBox="0 0 200 92" style={`top:${c.top}%;width:${c.width}px;animation-duration:${c.dur}s;animation-delay:${c.delay}s`}>
        <use href="#cloud" />
      </svg>
    ))}
  </div>

  <svg class="sky-edge" viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path d="M0 60V30Q75 6 150 28T300 26 450 30 600 24 750 30 900 26 1050 30 1200 24V60z" fill="var(--page)" />
  </svg>
</div>

<style>
  .sky { position: absolute; inset: 0 0 auto 0; height: 360px; z-index: -1; overflow: hidden; background: var(--grain), linear-gradient(to bottom, var(--sky), var(--sky-2)); transition: height 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .sky.is-tall { height: var(--sky-tall); }
  .sky-layer { position: absolute; inset: 0; transform: translate3d(calc(var(--mx, 0) * var(--depth, 10) * 1px), calc(var(--my, 0) * var(--depth, 10) * 0.5px), 0); transition: transform 0.6s ease-out; }
  .sky-layer[data-depth='10'] { --depth: 10; }
  .sky-layer[data-depth='22'] { --depth: 22; }

  .cloud { position: absolute; left: 0; fill: var(--cloud); filter: var(--cut); animation: drift linear infinite; will-change: transform; }
  @keyframes drift { from { transform: translateX(-320px); } to { transform: translateX(100vw); } }

  .sun { position: absolute; top: 9%; right: max(7%, calc(50% - 480px)); width: clamp(96px, 12vw, 140px); filter: var(--cut); }
  .rays { transform-origin: 70px 70px; animation: spin 80s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .mark { position: absolute; }
  .mark path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.4s 0.5s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .squiggle { width: 110px; left: max(5%, calc(50% - 560px)); top: 58%; transform: rotate(-8deg); }
  .arc { width: 74px; right: max(22%, calc(50% - 300px)); top: 62%; }
  .blob { position: absolute; width: 54px; height: 50px; left: 18%; top: 22%; background: var(--sage); border-radius: 58% 42% 55% 45% / 48% 60% 40% 52%; animation: bob 9s ease-in-out infinite; }
  .dots { position: absolute; width: 150px; height: 110px; right: 3%; top: 48%; background-image: radial-gradient(rgb(34 49 63 / 0.22) 1.6px, transparent 1.7px); background-size: 12px 12px; border-radius: 40% 60% 50% 50%; }
  @keyframes bob { 50% { transform: translateY(-10px) rotate(8deg); } }

  .sky-edge { position: absolute; left: 0; bottom: -1px; width: 100%; height: clamp(28px, 4vw, 56px); }

  .sky:not(.is-tall) .squiggle, .sky:not(.is-tall) .arc, .sky:not(.is-tall) .c4 { display: none; }
  .sky:not(.is-tall) .sun { width: 84px; top: 14%; }
  @media (max-width: 640px) {
    .dots, .c3, .blob { display: none; }
    .sun { top: 15%; right: 6%; }
    .cloud { scale: 0.7; transform-origin: left top; }
    .squiggle { width: 76px; top: 70%; }
    .arc { width: 50px; top: 74%; right: 10%; }
  }
</style>
