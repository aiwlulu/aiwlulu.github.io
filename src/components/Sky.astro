---
interface Props { tall?: boolean }
const { tall = false } = Astro.props;
---

<canvas class:list={['sky', { 'is-tall': tall }]} aria-hidden="true"></canvas>

<script>
  import { mountScene } from '../scripts/scene';
  import frag from '../scripts/sky.frag';
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.sky');
  if (canvas) mountScene(canvas, frag);
</script>

<style>
  .sky {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
    height: 340px;
    z-index: -1;
    /* Shown until the shader draws, and when WebGL is unavailable. */
    background:
      radial-gradient(60% 80% at 78% 22%, var(--sun) 0%, transparent 60%),
      linear-gradient(to bottom, var(--sky-top), var(--sky-low));
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .sky.is-tall { height: min(78vh, 720px); min-height: 480px; }
</style>
