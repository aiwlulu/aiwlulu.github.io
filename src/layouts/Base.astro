---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Sky from '../components/Sky.astro';
import Sea from '../components/Sea.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';

type Props = Parameters<typeof Seo>[0] & { tallSky?: boolean; progress?: boolean };
const { tallSky = false, progress = false, ...seo } = Astro.props;
const path = Astro.url.pathname;
const lang = seo.lang ?? SITE.lang;
const en = lang === 'en';
const t = en
  ? { skip: 'Skip to content', home: 'Home', posts: 'Posts', about: 'About', main: 'Main', brand: `${SITE.name} home`, sky: 'Appearance', theme: 'Theme', hue: 'Sky', hint: 'Automatic follows your device, then your local time.' }
  : { skip: '跳到主要內容', home: '首頁', posts: '文章', about: '關於', main: '主要', brand: `${SITE.name}首頁`, sky: '外觀設定', theme: '外觀', hue: '天色', hint: '自動：先看裝置設定，再依當地時間。' };
const themes = [
  { value: 'auto', icon: 'sun-moon' as const, label: en ? 'Automatic' : '自動' },
  { value: 'day', icon: 'sun' as const, label: en ? 'Light' : '淺色' },
  { value: 'night', icon: 'moon' as const, label: en ? 'Dark' : '深色' },
];
// Sky colour while the light theme is on.
const hues = [
  { value: 'auto', icon: 'clock' as const, label: en ? 'By time of day' : '依時間' },
  { value: 'dawn', icon: 'sunrise' as const, label: en ? 'Dawn' : '清晨' },
  { value: 'day', icon: 'sun' as const, label: en ? 'Day' : '白天' },
  { value: 'dusk', icon: 'sunset' as const, label: en ? 'Dusk' : '黃昏' },
];
const nav = [
  { href: '/', label: t.home, icon: 'house' as const, on: path === '/' },
  { href: '/blog/', label: t.posts, icon: 'book-open' as const, on: path.startsWith('/blog') || path.startsWith('/categories') || path.startsWith('/tags') },
  { href: en ? '/en/about/' : '/about/', label: t.about, icon: 'user-round' as const, on: path.includes('/about') },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#9ccbf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121b33" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...seo} />
    <ClientRouter />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      // Same rule as resolveTheme() in src/scripts/palette.ts: the reader's choice, then the
      // device setting, then the local time.
      (function () {
        var root = document.documentElement, mode = 'auto';
        root.classList.add('js');
        var hue = 'auto';
        try { mode = localStorage.getItem('sky-mode') || 'auto'; hue = localStorage.getItem('sky-hue') || 'auto'; } catch (e) {}
        root.dataset.skyMode = mode;
        root.dataset.skyHue = hue;
        var d = new Date(), h = d.getHours() + d.getMinutes() / 60, night = h >= 19.2 || h < 5.3;
        var m = location.search.match(/[?&]hour=([\d.]+)/);
        if (m) { var p = Number(m[1]); night = p >= 19.2 || p < 5.3; mode = night ? 'night' : 'day'; }
        var dark = mode === 'night' || (mode === 'auto' && (matchMedia('(prefers-color-scheme: dark)').matches || night));
        root.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body data-sky={tallSky ? 'tall' : 'short'}>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="loadbar" transition:persist="loadbar" aria-hidden="true"></div>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <Sky tall={tallSky} />
    <header class="top wrap" transition:name="top">
      <a class="brand" href="/" aria-label={t.brand}>
        <img src="/favicon.svg" alt="" width="46" height="46" />
        <span>{SITE.name}</span>
      </a>
      <nav class="nav" aria-label={t.main}>
        {nav.map((n) => <a href={n.href} aria-current={n.on ? 'page' : undefined}><Icon name={n.icon} size={16} />{n.label}</a>)}
        <button class="nav-icon sky-mode" type="button" popovertarget="sky-menu" aria-label={t.sky} title={t.sky}>
          <Icon name="sun-moon" class="m-auto" /><Icon name="sun" class="m-day" /><Icon name="moon" class="m-night" />
        </button>
        <a href={SITE.github} target="_blank" rel="me noopener noreferrer" class="nav-icon" aria-label="GitHub（另開視窗）"><Icon name="github" /></a>
      </nav>
    </header>
    <div class="sky-menu" id="sky-menu" popover>
      <fieldset>
        <legend>{t.theme}</legend>
        {themes.map((o) => <label><input type="radio" name="sky-mode" value={o.value} /><Icon name={o.icon} size={16} />{o.label}</label>)}
      </fieldset>
      <fieldset class="hues">
        <legend>{t.hue}</legend>
        {hues.map((o) => <label><input type="radio" name="sky-hue" value={o.value} /><Icon name={o.icon} size={16} />{o.label}</label>)}
      </fieldset>
      <p>{t.hint}</p>
    </div>
    <main id="main">
      <slot />
    </main>
    <Sea lang={lang} />
    <dialog class="lightbox" transition:persist="lightbox" aria-label="放大的圖片">
      <button class="lightbox-close" type="button" aria-label="關閉"><Icon name="x" size={20} /></button>
      <figure><figcaption></figcaption></figure>
    </dialog>
    <div class="cursor" transition:persist="cursor" aria-hidden="true"></div>
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
