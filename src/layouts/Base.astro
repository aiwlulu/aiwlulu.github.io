---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Sky from '../components/Sky.astro';
import Sea from '../components/Sea.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';

type Props = Parameters<typeof Seo>[0] & { tallSky?: boolean; progress?: boolean };
const { tallSky = false, progress = false, ...seo } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首頁', icon: 'house' as const, on: path === '/' },
  { href: '/blog/', label: '文章', icon: 'book-open' as const, on: path.startsWith('/blog') || path.startsWith('/categories') || path.startsWith('/tags') },
  { href: '/about/', label: '關於', icon: 'user-round' as const, on: path.startsWith('/about') },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#9ccbf5" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <Seo {...seo} />
    <ClientRouter />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-sky={tallSky ? 'tall' : 'short'}>
    <a class="skip" href="#main">跳到主要內容</a>
    <div class="loadbar" transition:persist="loadbar" aria-hidden="true"></div>
    {progress && <div class="progress" aria-hidden="true"></div>}
    <Sky tall={tallSky} />
    <header class="top wrap" transition:name="top">
      <a class="brand" href="/" aria-label={`${SITE.name}首頁`}>
        <img src="/favicon.svg" alt="" width="46" height="46" />
        <span>{SITE.name}</span>
      </a>
      <nav class="nav" aria-label="主要">
        {nav.map((n) => <a href={n.href} aria-current={n.on ? 'page' : undefined}><Icon name={n.icon} size={16} />{n.label}</a>)}
        <a href={SITE.github} target="_blank" rel="me noopener noreferrer" class="nav-icon" aria-label="GitHub（另開視窗）"><Icon name="github" /></a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <Sea />
    <dialog class="lightbox" transition:persist="lightbox" aria-label="放大的圖片">
      <button class="lightbox-close" type="button" aria-label="關閉"><Icon name="x" size={20} /></button>
      <figure><figcaption></figcaption></figure>
    </dialog>
    <div class="cursor" transition:persist="cursor" aria-hidden="true"></div>
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
